<?xml version="1.0" encoding="utf-8"?>
<!--
  2x4 小组件（深色）
  顶行 emoji + 设备名 + 状态；下面 上次消费 → 计时器 → 占满剩余空间的圆形开关按钮。
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/widget_bg_dark"
    android:padding="12dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/widget_emoji"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="17sp"
            android:text="🚿" />

        <TextView
            android:id="@+id/widget_device"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:textSize="14sp"
            android:textStyle="bold"
            android:maxLines="1"
            android:ellipsize="end"
            android:textColor="#E6EDF3"
            android:text="未绑定设备" />

        <TextView
            android:id="@+id/widget_status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="12sp"
            android:textColor="#8B949E"
            android:text="空闲" />
    </LinearLayout>

    <TextView
        android:id="@+id/widget_lastconsume"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:textSize="10sp"
        android:maxLines="1"
        android:ellipsize="end"
        android:textColor="#8B949E"
        android:text="上次消费 ¥0.00" />

    <Chronometer
        android:id="@+id/widget_timer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:gravity="center"
        android:textSize="16sp"
        android:textStyle="bold"
        android:textColor="#E6EDF3"
        android:text="00:00" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <ImageView
            android:id="@+id/widget_action_start"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="fitCenter"
            android:src="@drawable/widget_circle_start_dark" />

        <ImageView
            android:id="@+id/widget_action_stop"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="fitCenter"
            android:src="@drawable/widget_circle_stop_dark"
            android:visibility="gone" />

        <TextView
            android:id="@+id/widget_action_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:textSize="26sp"
            android:textStyle="bold"
            android:textColor="#0E131D"
            android:text="开" />
    </FrameLayout>
</LinearLayout>
