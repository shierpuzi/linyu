<?xml version="1.0" encoding="utf-8"?>
<!--
  2x2 竖向小组件（浅色）
  第一行 emoji + 设备名 → 第二行「上次消费」→ 计时器 → 圆形开关按钮（占满剩余空间）

  按钮为什么用 ImageView + scaleType="fitCenter"：
  TextView 的背景会拉伸成随容器变形的椭圆，做不到「跟着空间变大但仍是正圆」。
  ImageView 的 fitCenter 按 drawable 的固有宽高比缩放，而圆形 drawable 里写了
  <size 100dp x 100dp>，所以它会始终等比缩放成正圆，边长取容器宽高的较小值。

  开/关两个圆切成两张 drawable 靠 visibility 切换，而不是运行时改背景：
  RemoteViews 换背景只能靠 setInt(id,"setBackgroundResource",...) 反射调用，
  框架对反射方法有 @RemotableViewMethod 白名单，赌错会让整个小组件渲染失败。
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/widget_bg_light"
    android:padding="12dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/widget_emoji"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="15sp"
            android:text="🚿" />

        <TextView
            android:id="@+id/widget_device"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="6dp"
            android:textSize="13sp"
            android:textStyle="bold"
            android:maxLines="1"
            android:ellipsize="end"
            android:textColor="#111827"
            android:text="未绑定设备" />
    </LinearLayout>

    <TextView
        android:id="@+id/widget_lastconsume"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:textSize="10sp"
        android:maxLines="1"
        android:ellipsize="end"
        android:textColor="#6B7280"
        android:text="上次消费 ¥0.00" />

    <!--
      计时器和圆形按钮放在同一组里，且这一组整体贴住底部。
      之前计时器是独立一行、按钮在下面靠 weight 撑满并居中，
      小组件拉高后按钮会在中间浮着，和计时器之间裂开一大块空白——
      计时器看着就"跑上面去了"。现在多余的空间全部留在这一组的上方。
    -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <!--
          上下两个弹性占位：权重 1 : 0.6，多出来的高度按 62.5% : 37.5% 分给上下，
          计时器和按钮就落在「比正中间略低一点」的位置。
          想让按钮再往下就把下面那个的 weight 调小，想居中就调成和上面一样。
          用空 TextView 而不是 Space —— RemoteViews 对可用的 View 类型有白名单，
          Space 不在保证范围内，inflate 失败会导致整个小组件直接渲染不出来。
        -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <Chronometer
            android:id="@+id/widget_timer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:gravity="center"
            android:textSize="15sp"
            android:textStyle="bold"
            android:textColor="#111827"
            android:text="00:00" />

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <ImageView
                android:id="@+id/widget_action_start"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:scaleType="fitCenter"
                android:src="@drawable/widget_circle_start_light" />

            <ImageView
                android:id="@+id/widget_action_stop"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:scaleType="fitCenter"
                android:src="@drawable/widget_circle_stop_light"
                android:visibility="gone" />

            <TextView
                android:id="@+id/widget_action_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:textSize="26sp"
                android:textStyle="bold"
                android:textColor="#FFFFFF"
                android:text="开" />
        </FrameLayout>

        <!-- 下方弹性占位：比上面的权重小，于是整组略微偏下 -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="0.6" />
    </LinearLayout>
</LinearLayout>
