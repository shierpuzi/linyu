<?xml version="1.0" encoding="utf-8"?>
<!-- 水滴球·开：玻璃球体，径向高光偏左上，模拟受光 -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="oval">
    <gradient android:type="radial"
        android:centerX="0.35" android:centerY="0.30"
        android:gradientRadius="32dp">
        <item android:offset="0" android:color="#2EFFFFFF" />
        <item android:offset="0.6" android:color="#14FFFFFF" />
        <item android:offset="1" android:color="#0AFFFFFF" />
    </gradient>
    <stroke android:width="1dp" android:color="#29FFFFFF" />
</shape>
